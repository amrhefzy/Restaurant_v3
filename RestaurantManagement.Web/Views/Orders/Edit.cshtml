@model RestaurantManagement.Application.DTOs.Orders.UpdateOrderDto
@{
    ViewData["Title"] = "Edit Order";
    ViewData["PageActions"] = "<a class='btn btn-outline-secondary' href='/Orders'>Back to list</a>";
    var productOptions = (IEnumerable<SelectListItem>)ViewBag.Products;
    var rows = Math.Max(3, Model.Items.Count);
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">Edit order</h5>
            <small class="text-muted">Adjust order header values, table assignment, and item lines.</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3" data-confirm="Save updates to this order?" data-confirm-text="Update order" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">Order header</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="OrderType" class="form-label"></label>
                <select asp-for="OrderType" asp-items="Html.GetEnumSelectList<RestaurantManagement.Domain.Enums.OrderType>()" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<RestaurantManagement.Domain.Enums.OrderStatus>()" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                    <option value="">Walk-in / None</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="TableId" class="form-label"></label>
                <select asp-for="TableId" asp-items="ViewBag.Tables" class="form-select">
                    <option value="">Unassigned</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="TaxAmount" class="form-label"></label>
                <input asp-for="TaxAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="TaxAmount" class="text-danger"></span>
            </div>
            <div class="col-md-9">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div class="form-section-title mt-4">Order items</div>
        <div class="table-responsive table-wrapper">
            <table class="table shell-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 42%;">Product</th>
                        <th style="width: 16%;">Qty</th>
                        <th style="width: 18%;">Price</th>
                        <th style="width: 24%;">Note</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < rows; i++)
                    {
                        var item = i < Model.Items.Count ? Model.Items[i] : new RestaurantManagement.Application.DTOs.Orders.UpdateOrderItemDto();
                        <tr>
                            <td>
                                <input type="hidden" name="Items[@i].Id" value="@item.Id" />
                                <select name="Items[@i].ProductId" class="form-select">
                                    <option value="">Select product</option>
                                    @foreach (var option in productOptions)
                                    {
                                        <option value="@option.Value" selected="@(option.Value == item.ProductId.ToString())">@option.Text</option>
                                    }
                                </select>
                            </td>
                            <td><input name="Items[@i].Quantity" value="@item.Quantity" class="form-control" type="number" step="0.001" min="0.001" /></td>
                            <td><input name="Items[@i].Price" value="@item.Price" class="form-control" type="number" step="0.01" min="0" /></td>
                            <td><input name="Items[@i].Note" value="@item.Note" class="form-control" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">Update</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
