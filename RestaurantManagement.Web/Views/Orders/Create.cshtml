@model RestaurantManagement.Application.DTOs.Orders.CreateOrderDto
@{
    ViewData["Title"] = "Create Order";
    var productOptions = (IEnumerable<SelectListItem>)ViewBag.Products;
}

<div class="widget-card">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Create Order</h5>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>

    <form asp-action="Create" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="OrderType" class="form-label"></label>
                <select asp-for="OrderType" asp-items="Html.GetEnumSelectList<RestaurantManagement.Domain.Enums.OrderType>()" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<RestaurantManagement.Domain.Enums.OrderStatus>()" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                    <option value="">Walk-in / None</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="TableId" class="form-label"></label>
                <select asp-for="TableId" asp-items="ViewBag.Tables" class="form-select">
                    <option value="">Unassigned</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="TaxAmount" class="form-label"></label>
                <input asp-for="TaxAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="TaxAmount" class="text-danger"></span>
            </div>
            <div class="col-md-9">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4">
            <h6 class="mb-2">Items</h6>
            <div class="table-responsive">
                <table class="table shell-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 45%;">Product</th>
                            <th style="width: 20%;">Qty</th>
                            <th style="width: 20%;">Price</th>
                            <th style="width: 15%;">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < 3; i++)
                        {
                            <tr>
                                <td>
                                    <select name="Items[@i].ProductId" class="form-select">
                                        <option value="">Select product</option>
                                        @foreach (var option in productOptions)
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    </select>
                                </td>
                                <td><input name="Items[@i].Quantity" value="@(i == 0 ? "1" : string.Empty)" class="form-control" type="number" step="0.001" min="0.001" /></td>
                                <td><input name="Items[@i].Price" value="0" class="form-control" type="number" step="0.01" min="0" /></td>
                                <td><input name="Items[@i].Note" class="form-control" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
