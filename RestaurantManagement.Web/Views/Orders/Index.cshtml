@model IReadOnlyCollection<RestaurantManagement.Application.DTOs.Orders.OrderDto>
@{
    ViewData["Title"] = "Orders";
    ViewData["PageActions"] = "<a class='btn btn-primary' href='/Orders/Create'>Create order</a>";
}

<div class="widget-card crud-shell">
    <div class="crud-toolbar">
        <div>
            <h5 class="mb-1">Order register</h5>
            <small class="text-muted">Recent @Model.Count order records for dine-in, takeaway, and delivery operations.</small>
        </div>
        <div class="crud-toolbar-actions">
            <div class="crud-search">
                <input type="search" class="form-control" id="ordersTableSearch" placeholder="Search by order number, type, or status" />
            </div>
            <a class="btn btn-primary" asp-action="Create">Create order</a>
        </div>
    </div>

    <div class="table-responsive mt-3 table-wrapper">
        <table class="table shell-table align-middle mb-0" id="ordersTable">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Date (UTC)</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Subtotal</th>
                    <th class="text-end">Tax</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td>
                            <div class="table-title">@row.OrderNumber</div>
                            <div class="table-subtitle">@row.OrderType · @row.Status</div>
                        </td>
                        <td>@row.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge text-bg-light">@row.OrderType</span></td>
                        <td><span class="badge text-bg-light">@row.Status</span></td>
                        <td class="text-end">@row.Subtotal.ToString("N2")</td>
                        <td class="text-end">@row.TaxAmount.ToString("N2")</td>
                        <td class="text-end fw-semibold">@row.Total.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.Id">Edit</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8" class="empty-state">No orders created yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("ordersTableSearch");
            const table = document.getElementById("ordersTable");
            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function () {
                const value = this.value.trim().toLowerCase();
                table.querySelectorAll("tbody tr").forEach((row) => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(value) ? "" : "none";
                });
            });
        });
    </script>
}
