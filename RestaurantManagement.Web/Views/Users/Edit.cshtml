@model RestaurantManagement.Web.ViewModels.Users.EditUserViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["EditUser"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Users'>{L["BackToList"]}</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["EditUser"]</h5>
            <small class="text-muted">@L["UpdateUserProfileRoleAndAccessState"]</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3" data-confirm="@L["SaveUpdatesToThisUser"]" data-confirm-text="@L["UpdateUser"]" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">@L["UserAccountInformation"]</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label">@L["FullName"]</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">@L["Email"]</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PhoneNumber" class="form-label">@L["Phone"]</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="RoleName" class="form-label">@L["Role"]</label>
                <select asp-for="RoleName" asp-items="Model.RoleOptions" class="form-select"></select>
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">@L["Active"]</label>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">@L["UpdateUser"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
