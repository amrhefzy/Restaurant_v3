@model RestaurantManagement.Web.ViewModels.Users.ResetPasswordViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ResetPassword"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Users'>{L["BackToList"]}</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["ResetPassword"]</h5>
            <small class="text-muted">@Model.UserDisplayName</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    <form asp-action="ResetPassword" method="post" class="mt-3" data-confirm="@L["ResetThisPasswordNow"]" data-confirm-text="@L["ResetPassword"]" data-confirm-class="btn-danger">
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />
        <input asp-for="UserDisplayName" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="form-section-title">@L["PasswordReset"]</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NewPassword" class="form-label">@L["NewPassword"]</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-danger">@L["ResetPassword"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
