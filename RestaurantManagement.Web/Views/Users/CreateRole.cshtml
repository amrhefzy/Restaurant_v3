@model RestaurantManagement.Web.ViewModels.Users.CreateRoleViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["CreateRole"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Users/Roles'>{L["BackToList"]}</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["CreateRole"]</h5>
            <small class="text-muted">@L["AddRoleForOperationalAccessControl"]</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Roles">@L["BackToList"]</a>
    </div>

    <form asp-action="CreateRole" method="post" class="mt-3" data-confirm="@L["CreateThisRoleNow"]" data-confirm-text="@L["CreateRole"]" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="form-section-title">@L["RoleInformation"]</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">@L["Role"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="Description" class="form-label">@L["Description"]</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">@L["CreateRole"]</button>
            <a class="btn btn-outline-secondary" asp-action="Roles">@L["Cancel"]</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
