@model RestaurantManagement.Application.DTOs.Tables.CreateTableDto
@{
    ViewData["Title"] = "Create Table";
}

<div class="widget-card">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Create Table</h5>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>

    <form asp-action="Create" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="TableNumber" class="form-label"></label>
                <input asp-for="TableNumber" class="form-control" />
                <span asp-validation-for="TableNumber" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" max="20" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
