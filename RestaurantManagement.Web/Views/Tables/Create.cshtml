@model RestaurantManagement.Application.DTOs.Tables.CreateTableDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["CreateTable"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Tables'>{L["BackToList"]}</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["CreateTable"]</h5>
            <small class="text-muted">Add a new dine-in table with a visible number and serving capacity.</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    <form asp-action="Create" method="post" class="mt-3" data-confirm="Save this table now?" data-confirm-text="Save table" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">Table information</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="TableNumber" class="form-label"></label>
                <input asp-for="TableNumber" class="form-control" />
                <span asp-validation-for="TableNumber" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" max="20" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
