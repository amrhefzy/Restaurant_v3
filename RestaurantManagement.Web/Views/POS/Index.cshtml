@model RestaurantManagement.Application.DTOs.POS.PosScreenDataDto
@using System.Text.Json
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Pos"];
    var dataJson = JsonSerializer.Serialize(Model);
}

<div class="pos-shell" id="posApp"
     data-pos='@Html.Raw(dataJson)'
     data-msg-add-item="@L["AddAtLeastOneItem"]"
     data-msg-select-table="@L["SelectTableForDineIn"]"
     data-msg-cart-empty="@L["CartEmptyValidation"]"
     data-msg-select-payment="@L["SelectPaymentType"]">
    @Html.AntiForgeryToken()
    <section class="pos-catalog" aria-label="Product catalog panel">
        <header class="pos-header">
            <div>
                <h4 class="mb-1">@L["PointOfSale"]</h4>
                <small class="text-muted">@L["FastCashierFlow"]</small>
            </div>
            <div class="pos-search-wrap">
                <input id="posSearch" type="search" class="form-control" placeholder="@L["SearchProductsPlaceholder"]" autocomplete="off" />
            </div>
        </header>

        <div class="pos-shortcuts mb-3">
            <span class="badge text-bg-light">Ctrl/Cmd + F</span>
            <small class="text-muted">Focus search</small>
            <span class="badge text-bg-light">Enter</span>
            <small class="text-muted">Checkout</small>
            <span class="badge text-bg-light">Esc</span>
            <small class="text-muted">Clear cart</small>
        </div>

        <div class="pos-categories" id="posCategories" role="tablist" aria-label="Categories"></div>
        <div class="pos-products" id="posProducts" aria-live="polite"></div>
        <div class="pos-products-footer">
            <small class="text-muted" id="posProductsMeta"></small>
            <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="posLoadMoreBtn">@L["LoadMore"]</button>
        </div>
    </section>

    <aside class="pos-cart" aria-label="Order ticket panel">
        <div id="posValidationSummary" class="alert alert-danger py-2 px-3 d-none mb-2" role="alert"></div>

        <div class="pos-cart-head">
            <div>
                <h5 class="mb-1">@L["CurrentTicket"]</h5>
                <small id="cartItemCount">0 item(s)</small>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="clearCartBtn">@L["Clear"]</button>
        </div>

        <div class="pos-cart-lines" id="cartLines"></div>
        <small class="d-block text-danger mt-1 d-none" id="cartValidationMessage"></small>

        <div class="pos-options">
            <label class="form-label mb-2">@L["OrderType"]</label>
            <div class="btn-group w-100" role="group" aria-label="Order type selector" id="orderTypeGroup">
                <input type="radio" class="btn-check" name="orderType" id="orderTypeDineIn" value="1" />
                <label class="btn btn-outline-dark" for="orderTypeDineIn">@L["DineIn"]</label>

                <input type="radio" class="btn-check" name="orderType" id="orderTypeTakeaway" value="2" checked />
                <label class="btn btn-outline-dark" for="orderTypeTakeaway">@L["Takeaway"]</label>

                <input type="radio" class="btn-check" name="orderType" id="orderTypeDelivery" value="3" />
                <label class="btn btn-outline-dark" for="orderTypeDelivery">@L["Delivery"]</label>
            </div>

            <label class="form-label mt-3" id="tableLabel">@L["TableDineIn"]</label>
            <select id="tableId" class="form-select form-select-sm">
                <option value="">@L["NoTable"]</option>
                @foreach (var table in Model.Tables)
                {
                    <option value="@table.Id">@table.TableNumber (@table.Status)</option>
                }
            </select>
            <small class="text-muted d-block mt-1" id="tableHint">@L["TableRequiredHint"]</small>
            <small class="d-block text-danger mt-1 d-none" id="tableValidationMessage"></small>

            <label class="form-label mt-2">@L["Notes"]</label>
            <textarea id="orderNotes" class="form-control form-control-sm" rows="2" placeholder="@L["KitchenNotesPlaceholder"]"></textarea>

            <label class="form-label mt-3">@L["PaymentType"]</label>
            <div class="btn-group w-100" role="group" aria-label="Payment type selector" id="paymentTypeGroup">
                <input type="radio" class="btn-check" name="paymentType" id="paymentTypeCash" value="1" checked />
                <label class="btn btn-outline-dark" for="paymentTypeCash">@L["Cash"]</label>

                <input type="radio" class="btn-check" name="paymentType" id="paymentTypeCard" value="2" />
                <label class="btn btn-outline-dark" for="paymentTypeCard">@L["Card"]</label>
            </div>
            <small class="d-block text-danger mt-1 d-none" id="paymentValidationMessage"></small>
        </div>

        <div class="pos-totals">
            <div><span>@L["Subtotal"]</span><strong id="subtotalValue">0.00</strong></div>
            <div><span>@L["Tax"]</span><strong id="taxValue">0.00</strong></div>
            <div class="grand"><span>@L["Total"]</span><strong id="totalValue">0.00</strong></div>
        </div>

        <div class="pos-actions">
            <button type="button" id="holdOrderBtn" class="btn btn-outline-secondary">@L["HoldOrder"]</button>
            <button type="button" id="checkoutBtn" class="btn btn-primary">@L["Checkout"]</button>
        </div>

        <div class="held-orders mt-3">
            <h6>@L["HeldOrders"]</h6>
            <div id="heldOrdersList" class="held-orders-list"></div>
        </div>

        <div class="held-orders mt-3">
            <h6>@L["KitchenStatusFeed"]</h6>
            <div id="posStatusFeed" class="held-orders-list"></div>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/pos.js" asp-append-version="true"></script>
}
