@model IReadOnlyCollection<RestaurantManagement.Application.DTOs.Kitchen.KitchenOrderCardDto>
@using System.Text.Json
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Kitchen"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Dashboard'>{L["Dashboard"]}</a>";
    var dataJson = JsonSerializer.Serialize(Model);
}

<div id="kitchenApp"
     class="kitchen-shell"
     data-seed='@Html.Raw(dataJson)'
     data-no-active='@L["NoActiveOrders"]'
     data-start='@L["Start"]'
     data-ready='@L["MarkReady"]'>
    @Html.AntiForgeryToken()
    <div class="kitchen-toolbar mb-3">
        <div>
            <h4 class="mb-1">@L["Kitchen"]</h4>
            <small class="text-muted">@L["LiveOperations"]</small>
        </div>
        <div class="kitchen-toolbar-actions">
            <span class="badge text-bg-light">@L["AutoRefresh10s"]</span>
            <span class="badge text-bg-light">@L["AudioAlertOnNewOrders"]</span>
        </div>
    </div>
    <div id="kitchenBoard" class="kitchen-board"></div>
</div>

@section Scripts {
    <script src="~/js/kitchen.js" asp-append-version="true"></script>
}
