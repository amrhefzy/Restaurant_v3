@model RestaurantManagement.Application.DTOs.Returns.ReturnSummaryDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Returns"];
}

<div class="widget-card crud-shell">
    <div class="crud-toolbar">
        <div>
            <h5 class="mb-1">@L["ReturnsOverview"]</h5>
            <small class="text-muted">@L["MonitorSalesAndPurchaseReturnsAcrossTheCurrentReportingWindow"]</small>
        </div>
        <div class="crud-toolbar-actions">
            <span class="badge text-bg-light">@L["Last30Days"]</span>
        </div>
    </div>

    <section class="dashboard-grid mt-4">
        <article class="metric-card">
            <p class="metric-label">@L["SalesReturnsCount"]</p>
            <h3>@Model.SalesReturnsCount</h3>
        </article>
        <article class="metric-card warning">
            <p class="metric-label">@L["SalesReturnsTotal"]</p>
            <h3>@Model.SalesReturnsTotal.ToString("N2")</h3>
        </article>
        <article class="metric-card">
            <p class="metric-label">@L["PurchaseReturnsCount"]</p>
            <h3>@Model.PurchaseReturnsCount</h3>
        </article>
        <article class="metric-card warning">
            <p class="metric-label">@L["PurchaseReturnsTotal"]</p>
            <h3>@Model.PurchaseReturnsTotal.ToString("N2")</h3>
        </article>
    </section>

    <div class="row g-3 mt-1">
        <div class="col-lg-6">
            <div class="widget-card h-100">
                <div class="form-section-title">@L["SalesReturns"]</div>
                <div class="d-flex flex-column gap-2">
                    <div><strong>@L["Count"]:</strong> @Model.SalesReturnsCount</div>
                    <div><strong>@L["Amount"]:</strong> @Model.SalesReturnsTotal.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="widget-card h-100">
                <div class="form-section-title">@L["PurchaseReturns"]</div>
                <div class="d-flex flex-column gap-2">
                    <div><strong>@L["Count"]:</strong> @Model.PurchaseReturnsCount</div>
                    <div><strong>@L["Amount"]:</strong> @Model.PurchaseReturnsTotal.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
</div>
