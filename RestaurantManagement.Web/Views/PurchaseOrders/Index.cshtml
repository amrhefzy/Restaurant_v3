@model IReadOnlyCollection<RestaurantManagement.Application.DTOs.PurchaseOrders.PurchaseOrderListItemDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["PurchaseOrders"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Inventory'>{L["Inventory"]}</a>";
}

<div class="widget-card crud-shell">
    <div class="crud-toolbar">
        <div>
            <h5 class="mb-1">@L["PurchaseOrders"]</h5>
            <small class="text-muted">Recent supplier purchasing activity and receiving progress.</small>
        </div>
        <div class="crud-toolbar-actions">
            <div class="crud-search">
                <input type="search" class="form-control" id="purchaseOrdersSearch" placeholder="Search by PO number or status" />
            </div>
        </div>
    </div>
    <div class="table-responsive mt-3 table-wrapper">
        <table class="table shell-table mb-0" id="purchaseOrdersTable">
            <thead><tr><th>PO</th><th>Date (UTC)</th><th>@L["Status"]</th><th class="text-end">@L["Total"]</th></tr></thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td><div class="table-title">@row.PurchaseOrderNumber</div></td>
                        <td>@row.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge text-bg-light">@row.Status</span></td>
                        <td class="text-end">@row.Total.ToString("N2")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="empty-state">No purchase orders yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("purchaseOrdersSearch");
            const table = document.getElementById("purchaseOrdersTable");
            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function () {
                const value = this.value.trim().toLowerCase();
                table.querySelectorAll("tbody tr").forEach((row) => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(value) ? "" : "none";
                });
            });
        });
    </script>
}
