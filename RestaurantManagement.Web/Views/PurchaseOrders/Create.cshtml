@model RestaurantManagement.Application.DTOs.PurchaseOrders.CreatePurchaseOrderDto
@using Microsoft.AspNetCore.Mvc.Rendering
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["CreatePurchaseOrder"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/PurchaseOrders'>{L["BackToList"]}</a>";
    var productOptions = (IEnumerable<SelectListItem>)ViewBag.Products;
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["CreatePurchaseOrder"]</h5>
            <small class="text-muted">Create a supplier draft order with item quantities and unit costs.</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    <form asp-action="CreateDraft" method="post" class="mt-3" data-confirm="Save this purchase order draft now?" data-confirm-text="Save draft" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">@L["PurchaseOrderHeader"]</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                    <option value="">Select supplier</option>
                </select>
                <span asp-validation-for="SupplierId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="TaxAmount" class="form-label"></label>
                <input asp-for="TaxAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="TaxAmount" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div class="form-section-title mt-4">@L["PurchaseOrderItems"]</div>
        <div class="table-responsive table-wrapper">
            <table class="table shell-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 50%;">@L["Product"]</th>
                        <th style="width: 25%;">Quantity</th>
                        <th style="width: 25%;">Unit cost</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < 3; i++)
                    {
                        <tr>
                            <td>
                                <select name="Items[@i].ProductId" class="form-select">
                                    <option value="">Select product</option>
                                    @foreach (var option in productOptions)
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                </select>
                            </td>
                            <td><input name="Items[@i].Quantity" value="@(i == 0 ? "1" : string.Empty)" class="form-control" type="number" step="0.001" min="0.001" /></td>
                            <td><input name="Items[@i].UnitCost" value="0" class="form-control" type="number" step="0.01" min="0" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">Save draft</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
