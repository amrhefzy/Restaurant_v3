@model RestaurantManagement.Application.DTOs.PurchaseOrders.PurchaseOrderDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["PurchaseOrderDetails"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/PurchaseOrders'>{L["BackToList"]}</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["PurchaseOrderDetails"]</h5>
            <small class="text-muted">Review supplier, totals, line items, and receiving progress.</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-3"><div class="table-title">PO Number</div><div class="table-subtitle">@Model.PurchaseOrderNumber</div></div>
        <div class="col-md-3"><div class="table-title">Supplier</div><div class="table-subtitle">@Model.SupplierName</div></div>
        <div class="col-md-3"><div class="table-title">@L["Status"]</div><div class="table-subtitle">@Model.Status</div></div>
        <div class="col-md-3"><div class="table-title">Created</div><div class="table-subtitle">@Model.CreatedOn.ToString("yyyy-MM-dd HH:mm")</div></div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-4"><div class="table-title">@L["Subtotal"]</div><div class="table-subtitle">@Model.Subtotal.ToString("N2")</div></div>
        <div class="col-md-4"><div class="table-title">@L["Tax"]</div><div class="table-subtitle">@Model.TaxAmount.ToString("N2")</div></div>
        <div class="col-md-4"><div class="table-title">@L["Total"]</div><div class="table-subtitle">@Model.Total.ToString("N2")</div></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="form-section-title mt-4">Notes</div>
        <p class="mb-0">@Model.Notes</p>
    }

    <div class="form-section-title mt-4">@L["Items"]</div>
    <div class="table-responsive table-wrapper">
        <table class="table shell-table align-middle mb-0">
            <thead>
                <tr>
                    <th>@L["Product"]</th>
                    <th class="text-end">Ordered</th>
                    <th class="text-end">Received</th>
                    <th class="text-end">Remaining</th>
                    <th class="text-end">Unit cost</th>
                    <th class="text-end">Line total</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><div class="table-title">@item.ProductName</div></td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">@item.ReceivedQuantity</td>
                    <td class="text-end">@item.RemainingQuantity</td>
                    <td class="text-end">@item.UnitCost.ToString("N2")</td>
                    <td class="text-end">@item.LineTotal.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Status.ToString() == "Draft")
    {
        <form asp-action="Submit" asp-route-id="@Model.Id" method="post" class="mt-4" data-confirm="Submit this purchase order now?" data-confirm-text="Submit order" data-confirm-class="btn-primary">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">Submit purchase order</button>
        </form>
    }

    @if (Model.Items.Any(x => x.RemainingQuantity > 0) && Model.Status.ToString() != "Draft")
    {
        <form asp-action="Receive" asp-route-id="@Model.Id" method="post" class="mt-4" data-confirm="Save receiving for this purchase order?" data-confirm-text="Save receipt" data-confirm-class="btn-primary">
            @Html.AntiForgeryToken()
            <div class="form-section-title">Receive items</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Receipt reference</label>
                    <input name="ReceiptReferenceNumber" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Received on (UTC)</label>
                    <input name="ReceivedOnUtc" class="form-control" type="datetime-local" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Notes</label>
                    <input name="Notes" class="form-control" />
                </div>
            </div>
            <div class="table-responsive table-wrapper mt-3">
                <table class="table shell-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["Product"]</th>
                            <th class="text-end">Remaining</th>
                            <th class="text-end">Receive now</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ var index = 0; }
                    @foreach (var item in Model.Items.Where(x => x.RemainingQuantity > 0))
                    {
                        <tr>
                            <td>
                                <div class="table-title">@item.ProductName</div>
                                <input type="hidden" name="Items[@index].PurchaseOrderItemId" value="@item.Id" />
                            </td>
                            <td class="text-end">@item.RemainingQuantity</td>
                            <td class="text-end"><input name="Items[@index].ReceivedQuantity" class="form-control" type="number" step="0.001" min="0" /></td>
                        </tr>
                        index++;
                    }
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save receipt</button>
            </div>
        </form>
    }
</div>
