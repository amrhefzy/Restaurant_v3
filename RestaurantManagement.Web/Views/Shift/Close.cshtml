@model RestaurantManagement.Application.DTOs.Shifts.CloseShiftRequestDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["CloseShift"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Shift'>{L["BackToList"]}</a>";
    var currentShift = ViewBag.CurrentShift as RestaurantManagement.Application.DTOs.Shifts.ShiftSummaryDto;
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["CloseShift"]</h5>
            <small class="text-muted">@(currentShift?.ShiftNumber ?? L["CurrentShiftOverview"])</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    @if (currentShift is not null)
    {
        <div class="row g-3 mt-1">
            <div class="col-md-3 col-sm-6">
                <div class="metric-card h-100">
                    <p class="metric-label">@L["OpeningCash"]</p>
                    <h3>@currentShift.OpeningCash.ToString("N2")</h3>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="metric-card h-100">
                    <p class="metric-label">@L["TotalCash"]</p>
                    <h3>@currentShift.TotalCash.ToString("N2")</h3>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="metric-card h-100">
                    <p class="metric-label">@L["TotalCard"]</p>
                    <h3>@currentShift.TotalCard.ToString("N2")</h3>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="metric-card h-100">
                    <p class="metric-label">@L["ExpectedCash"]</p>
                    <h3>@currentShift.ExpectedCash.ToString("N2")</h3>
                </div>
            </div>
        </div>
    }

    <form asp-action="Close" method="post" class="mt-4" data-confirm="@L["ConfirmCloseShift"]" data-confirm-text="@L["CloseShift"]" data-confirm-class="btn-danger">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">@L["ShiftClosingDetails"]</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="ClosingCashActual" class="form-label">@L["ActualCash"]</label>
                <input asp-for="ClosingCashActual" type="number" step="0.01" class="form-control" min="0" />
                <span asp-validation-for="ClosingCashActual" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-danger">@L["CloseShift"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
