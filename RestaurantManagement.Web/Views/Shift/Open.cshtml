@model RestaurantManagement.Application.DTOs.Shifts.OpenShiftRequestDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["OpenShift"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Shift'>{L["BackToList"]}</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["OpenShift"]</h5>
            <small class="text-muted">@L["StartCashierSession"]</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    <form asp-action="Open" method="post" class="mt-3" data-confirm="@L["ConfirmOpenShift"]" data-confirm-text="@L["OpenShift"]" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">@L["ShiftOpeningDetails"]</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="OpeningCash" class="form-label">@L["OpeningCash"]</label>
                <input asp-for="OpeningCash" type="number" step="0.01" class="form-control" min="0" />
                <span asp-validation-for="OpeningCash" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">@L["OpenShift"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
