@model IReadOnlyCollection<RestaurantManagement.Application.DTOs.Reservations.ReservationDto>
@{
    ViewData["Title"] = "Reservations";
}

<div class="widget-card">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">Reservations</h5>
            <small class="text-muted">@Model.Count reservation records</small>
        </div>
        <a class="btn btn-primary" asp-action="Create">Create Reservation</a>
    </div>

    <div class="table-responsive mt-3">
        <table class="table shell-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Table</th>
                    <th>Date (UTC)</th>
                    <th>Party Size</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td>@row.CustomerName</td>
                        <td>@(row.TableNumber ?? "-")</td>
                        <td>@row.ReservationAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@row.PartySize</td>
                        <td>@row.Status</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.Id">Edit</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="empty-state">No reservations created yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
