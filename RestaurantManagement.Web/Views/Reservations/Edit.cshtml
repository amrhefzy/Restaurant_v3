@model RestaurantManagement.Application.DTOs.Reservations.UpdateReservationDto
@{
    ViewData["Title"] = "Edit Reservation";
    ViewData["PageActions"] = "<a class='btn btn-outline-secondary' href='/Reservations'>Back to list</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">Edit reservation</h5>
            <small class="text-muted">Adjust guest, timing, status, and table assignment details.</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3" data-confirm="Save updates to this reservation?" data-confirm-text="Update reservation" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">Reservation details</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"></select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TableId" class="form-label"></label>
                <select asp-for="TableId" asp-items="ViewBag.Tables" class="form-select">
                    <option value="">Unassigned</option>
                </select>
                <span asp-validation-for="TableId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PartySize" class="form-label"></label>
                <input asp-for="PartySize" class="form-control" type="number" min="1" max="20" />
                <span asp-validation-for="PartySize" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<RestaurantManagement.Domain.Enums.ReservationStatus>()" class="form-select"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ReservationAtUtc" class="form-label"></label>
                <input asp-for="ReservationAtUtc" class="form-control" type="datetime-local" value="@Model.ReservationAtUtc.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="ReservationAtUtc" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">Update</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
