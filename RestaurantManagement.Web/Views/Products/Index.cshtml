@model IReadOnlyCollection<RestaurantManagement.Application.DTOs.Products.ProductDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Products"];
    ViewData["PageActions"] = $"<a class='btn btn-primary' href='/Products/Create'>{L["CreateProduct"]}</a>";
}

<div class="widget-card crud-shell">
    <div class="crud-toolbar">
        <div>
            <h5 class="mb-1">@L["ProductsAndPricing"]</h5>
            <small class="text-muted">@Model.Count product records across the active branch.</small>
        </div>
        <div class="crud-toolbar-actions">
            <div class="crud-search">
                <input type="search" class="form-control" id="productTableSearch" placeholder="@L["SearchByEnglishNameOrSku"]" />
            </div>
            <a class="btn btn-primary" asp-action="Create">@L["CreateProduct"]</a>
        </div>
    </div>

    <div class="table-responsive mt-3 table-wrapper">
        <table class="table shell-table align-middle mb-0" id="productsTable">
            <thead>
                <tr>
                    <th>@L["Product"]</th>
                    <th>SKU</th>
                    <th class="text-end">Sale price</th>
                    <th class="text-end">Cost price</th>
                    <th>@L["StockTracking"]</th>
                    <th>@L["Status"]</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td>
                            <div class="table-title">@row.NameEn</div>
                            <div class="table-subtitle">@row.NameAr</div>
                        </td>
                        <td>@row.Sku</td>
                        <td class="text-end">@row.SalePrice.ToString("N2")</td>
                        <td class="text-end">@row.CostPrice.ToString("N2")</td>
                        <td>
                            <span class="badge rounded-pill @(row.IsStockTracked ? "text-bg-info" : "text-bg-light")">
                                @(row.IsStockTracked ? L["Tracked"] : L["NotTracked"])
                            </span>
                        </td>
                        <td>
                            <span class="badge @(row.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(row.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.Id">Edit</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="empty-state">No products created yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("productTableSearch");
            const table = document.getElementById("productsTable");
            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function () {
                const value = this.value.trim().toLowerCase();
                table.querySelectorAll("tbody tr").forEach((row) => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(value) ? "" : "none";
                });
            });
        });
    </script>
}
