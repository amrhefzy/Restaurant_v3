@model RestaurantManagement.Application.DTOs.Products.UpdateProductDto
@{
    ViewData["Title"] = "Edit Product";
    ViewData["PageActions"] = "<a class='btn btn-outline-secondary' href='/Products'>Back to list</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">Edit product</h5>
            <small class="text-muted">Update pricing, stock strategy, naming, and product activation.</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3" data-confirm="Save updates to this product?" data-confirm-text="Update product" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">Core information</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Sku" class="form-label"></label>
                <input asp-for="Sku" class="form-control" />
                <span asp-validation-for="Sku" class="text-danger"></span>
            </div>
            <div class="col-md-2 d-flex align-items-center">
                <div class="form-check mt-4 shell-check">
                    <input asp-for="IsStockTracked" class="form-check-input" />
                    <label asp-for="IsStockTracked" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-center">
                <div class="form-check mt-4 shell-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="NameEn" class="form-label"></label>
                <input asp-for="NameEn" class="form-control" />
                <span asp-validation-for="NameEn" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="NameAr" class="form-label"></label>
                <input asp-for="NameAr" class="form-control" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>
        </div>

        <div class="form-section-title mt-4">Pricing and replenishment</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="SalePrice" class="form-label"></label>
                <input asp-for="SalePrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="SalePrice" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CostPrice" class="form-label"></label>
                <input asp-for="CostPrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="CostPrice" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ReorderLevel" class="form-label"></label>
                <input asp-for="ReorderLevel" class="form-control" type="number" step="0.001" min="0" />
                <span asp-validation-for="ReorderLevel" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">Update</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
