@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using System.Globalization
@{
    var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Manager");
    var canOperate = canManage || User.IsInRole("Cashier");
}

<div class="topbar-content">
    <div>
        <div class="page-title">@L["RestaurantOperations"]</div>
        <div class="page-subtitle">@L["OperationalControlCenter"]</div>
    </div>

    <div class="topbar-actions">
        @if (canManage)
        {
            <a class="btn btn-sm btn-outline-secondary shell-quick-link" asp-controller="Dashboard" asp-action="Index">@L["Dashboard"]</a>
        }
        @if (canOperate)
        {
            <a class="btn btn-sm btn-outline-secondary shell-quick-link" asp-controller="POS" asp-action="Index">@L["Pos"]</a>
        }
        <form asp-controller="Culture" asp-action="Set" method="post" class="culture-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <select name="culture" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="en" selected="@(current == "en")">English</option>
                <option value="ar" selected="@(current == "ar")">العربية</option>
            </select>
        </form>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="btn btn-sm btn-outline-secondary disabled">@User.Identity?.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Logout"]</button>
            </form>
        }
        else
        {
            <a class="btn btn-sm btn-primary shell-quick-link" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">@L["Login"]</a>
        }
    </div>
</div>
