@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<div class="alert-grid">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success shell-alert alert-dismissible fade show" role="alert">
            <div class="shell-alert-body">
                <strong>@L["Success"]</strong>
                <span>@success</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger shell-alert alert-dismissible fade show" role="alert">
            <div class="shell-alert-body">
                <strong>@L["Error"]</strong>
                <span>@error</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Warning"] is string warning)
    {
        <div class="alert alert-warning shell-alert alert-dismissible fade show" role="alert">
            <div class="shell-alert-body">
                <strong>@L["Warning"]</strong>
                <span>@warning</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Info"] is string info)
    {
        <div class="alert alert-info shell-alert alert-dismissible fade show" role="alert">
            <div class="shell-alert-body">
                <strong>@L["Info"]</strong>
                <span>@info</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="inline-info" class="alert alert-info shell-alert d-none" role="alert"></div>
</div>
