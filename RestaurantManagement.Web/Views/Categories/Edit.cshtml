@model RestaurantManagement.Application.DTOs.Categories.UpdateCategoryDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = "Edit Category";
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Categories'>{L["BackToList"]}</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">Edit category</h5>
            <small class="text-muted">Update naming, ordering, and category availability.</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3" data-confirm="Save updates to this category?" data-confirm-text="Update category" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">Category information</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NameEn" class="form-label"></label>
                <input asp-for="NameEn" class="form-control" />
                <span asp-validation-for="NameEn" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="NameAr" class="form-label"></label>
                <input asp-for="NameAr" class="form-control" />
                <span asp-validation-for="NameAr" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <div class="form-check mt-4 shell-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">@L["Update"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
