@model IReadOnlyCollection<RestaurantManagement.Application.DTOs.Categories.CategoryDto>
@{
    ViewData["Title"] = "Categories";
    ViewData["PageActions"] = "<a class='btn btn-primary' href='/Categories/Create'>Create category</a>";
}

<div class="widget-card crud-shell">
    <div class="crud-toolbar">
        <div>
            <h5 class="mb-1">Category catalog</h5>
            <small class="text-muted">@Model.Count category records available for classification and POS filtering.</small>
        </div>
        <div class="crud-toolbar-actions">
            <div class="crud-search">
                <input type="search" class="form-control" id="categoryTableSearch" placeholder="Search by English or Arabic name" />
            </div>
            <a class="btn btn-primary" asp-action="Create">Create category</a>
        </div>
    </div>

    <div class="table-responsive mt-3 table-wrapper">
        <table class="table shell-table align-middle mb-0" id="categoriesTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Display order</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td>
                            <div class="table-title">@row.NameEn</div>
                            <div class="table-subtitle">@row.NameAr</div>
                        </td>
                        <td>@row.DisplayOrder</td>
                        <td>
                            <span class="badge @(row.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(row.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.Id">Edit</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="empty-state">No categories created yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("categoryTableSearch");
            const table = document.getElementById("categoriesTable");
            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function () {
                const value = this.value.trim().toLowerCase();
                table.querySelectorAll("tbody tr").forEach((row) => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(value) ? "" : "none";
                });
            });
        });
    </script>
}
