@model RestaurantManagement.Web.ViewModels.Settings.SettingsPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Settings"];
}

<form asp-action="Index" method="post" class="d-flex flex-column gap-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <section class="widget-grid">
        <article class="widget-card crud-shell">
            <div class="crud-toolbar">
                <div>
                    <h5 class="mb-1">@L["BusinessProfile"]</h5>
                    <small class="text-muted">@L["OperationalDefaultsAndStorefrontIdentity"]</small>
                </div>
                <div class="crud-toolbar-actions">
                    <span class="badge text-bg-light">@L["EditableFoundation"]</span>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label asp-for="BranchNameEn" class="form-label">@L["EnglishName"]</label>
                    <input asp-for="BranchNameEn" class="form-control" />
                    <span asp-validation-for="BranchNameEn" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BranchNameAr" class="form-label">@L["ArabicName"]</label>
                    <input asp-for="BranchNameAr" class="form-control" />
                    <span asp-validation-for="BranchNameAr" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="BranchAddress" class="form-label">@L["Address"]</label>
                    <input asp-for="BranchAddress" class="form-control" />
                    <span asp-validation-for="BranchAddress" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BranchPhone" class="form-label">@L["Phone"]</label>
                    <input asp-for="BranchPhone" class="form-control" />
                    <span asp-validation-for="BranchPhone" class="text-danger"></span>
                </div>
            </div>
        </article>

        <article class="widget-card crud-shell">
            <div class="crud-toolbar">
                <div>
                    <h5 class="mb-1">@L["SalesDefaults"]</h5>
                    <small class="text-muted">@L["CoreCommercialParametersForCheckoutAndReporting"]</small>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-4">
                    <label asp-for="CurrencyCode" class="form-label">@L["Currency"]</label>
                    <input asp-for="CurrencyCode" class="form-control" />
                    <span asp-validation-for="CurrencyCode" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TaxRatePercent" class="form-label">@L["TaxRate"]</label>
                    <input asp-for="TaxRatePercent" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="TaxRatePercent" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ServiceChargePercent" class="form-label">@L["ServiceCharge"]</label>
                    <input asp-for="ServiceChargePercent" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="ServiceChargePercent" class="text-danger"></span>
                </div>
            </div>
        </article>

        <article class="widget-card crud-shell">
            <div class="crud-toolbar">
                <div>
                    <h5 class="mb-1">@L["OperationalSwitches"]</h5>
                    <small class="text-muted">@L["OperationalBehaviorFlagsForAccessAndInventory"]</small>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="TrackInventory" class="form-check-input" />
                        <label asp-for="TrackInventory" class="form-check-label">@L["TrackInventory"]</label>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="RequireLoginForOperations" class="form-check-input" />
                        <label asp-for="RequireLoginForOperations" class="form-check-label">@L["RequireLoginForOperations"]</label>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="RoleAwareNavigationEnabled" class="form-check-input" />
                        <label asp-for="RoleAwareNavigationEnabled" class="form-check-label">@L["RoleAwareNavigation"]</label>
                    </div>
                </div>
            </div>
        </article>

        <article class="widget-card crud-shell">
            <div class="crud-toolbar">
                <div>
                    <h5 class="mb-1">@L["RuntimeDeploymentNotes"]</h5>
                    <small class="text-muted">@L["CurrentEnvironmentAndOperationalReadiness"]</small>
                </div>
            </div>

            <div class="mt-3">
                <label asp-for="RuntimeNotes" class="form-label">@L["RuntimeNotes"]</label>
                <textarea asp-for="RuntimeNotes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="RuntimeNotes" class="text-danger"></span>
            </div>
        </article>
    </section>

    <div class="d-flex gap-2 flex-wrap">
        <button type="submit" class="btn btn-primary">@L["SaveSettings"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
