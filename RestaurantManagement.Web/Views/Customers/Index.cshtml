@model IReadOnlyCollection<RestaurantManagement.Application.DTOs.Customers.CustomerDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Customers"];
    ViewData["PageActions"] = $"<a class='btn btn-primary' href='/Customers/Create'>{L["CreateCustomer"]}</a>";
}

<div class="widget-card crud-shell">
    <div class="crud-toolbar">
        <div>
            <h5 class="mb-1">@L["CustomerDirectory"]</h5>
            <small class="text-muted">@string.Format(L["CustomerRecordsCount"], Model.Count)</small>
        </div>
        <div class="crud-toolbar-actions">
            <div class="crud-search">
                <input type="search" class="form-control" id="customersTableSearch" placeholder="@L["SearchCustomersPlaceholder"]" />
            </div>
            <a class="btn btn-primary" asp-action="Create">@L["CreateCustomer"]</a>
        </div>
    </div>

    <div class="table-responsive mt-3 table-wrapper">
        <table class="table shell-table align-middle mb-0" id="customersTable">
            <thead>
                <tr>
                    <th>@L["Customer"]</th>
                    <th>@L["Phone"]</th>
                    <th>@L["Email"]</th>
                    <th>@L["Type"]</th>
                    <th>@L["Status"]</th>
                    <th class="text-end">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td>
                            <div class="table-title">@row.Name</div>
                            <div class="table-subtitle">@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Email) ? "—" : row.Email)</td>
                        <td><span class="badge text-bg-light">@(row.IsWalkIn ? L["WalkIn"] : L["Registered"])</span></td>
                        <td>
                            <span class="badge @(row.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(row.IsActive ? L["Active"] : L["Inactive"])
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.Id">@L["Edit"]</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="empty-state">@L["NoCustomersCreatedYet"]</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("customersTableSearch");
            const table = document.getElementById("customersTable");
            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function () {
                const value = this.value.trim().toLowerCase();
                table.querySelectorAll("tbody tr").forEach((row) => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(value) ? "" : "none";
                });
            });
        });
    </script>
}
