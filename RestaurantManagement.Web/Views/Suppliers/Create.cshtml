@model RestaurantManagement.Application.DTOs.Suppliers.CreateSupplierDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["CreateSupplier"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/Suppliers'>{L["BackToList"]}</a>";
}

<div class="widget-card form-shell">
    <div class="widget-head d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">@L["CreateSupplier"]</h5>
            <small class="text-muted">@L["AddSupplierForPurchasingAndDeliveryCoordination"]</small>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>

    <form asp-action="Create" method="post" class="mt-3" data-confirm="@L["SaveThisSupplierNow"]" data-confirm-text="@L["CreateSupplier"]" data-confirm-class="btn-primary">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section-title">@L["SupplierInformation"]</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactName" class="form-label"></label>
                <input asp-for="ContactName" class="form-control" />
                <span asp-validation-for="ContactName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <label asp-for="Address" class="form-label"></label>
                <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">@L["Save"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
