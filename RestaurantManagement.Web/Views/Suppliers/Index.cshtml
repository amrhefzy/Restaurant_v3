@model IReadOnlyCollection<RestaurantManagement.Application.DTOs.Suppliers.SupplierDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Suppliers"];
    ViewData["PageActions"] = $"<a class='btn btn-primary' href='/Suppliers/Create'>{L["CreateSupplier"]}</a>";
}

<div class="widget-card crud-shell">
    <div class="crud-toolbar">
        <div>
            <h5 class="mb-1">@L["SupplierDirectory"]</h5>
            <small class="text-muted">@string.Format(L["SupplierRecordsCount"], Model.Count)</small>
        </div>
        <div class="crud-toolbar-actions">
            <div class="crud-search">
                <input type="search" class="form-control" id="suppliersTableSearch" placeholder="@L["SearchSuppliersPlaceholder"]" />
            </div>
            <a class="btn btn-primary" asp-action="Create">@L["CreateSupplier"]</a>
        </div>
    </div>

    <div class="table-responsive mt-3 table-wrapper">
        <table class="table shell-table align-middle mb-0" id="suppliersTable">
            <thead>
                <tr>
                    <th>@L["Supplier"]</th>
                    <th>@L["Contact"]</th>
                    <th>@L["Phone"]</th>
                    <th>@L["Status"]</th>
                    <th class="text-end">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td>
                            <div class="table-title">@row.Name</div>
                            <div class="table-subtitle">@(string.IsNullOrWhiteSpace(row.ContactName) ? (string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone) : row.ContactName)</div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(row.ContactName) ? "—" : row.ContactName)</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                        <td>
                            <span class="badge @(row.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(row.IsActive ? L["Active"] : L["Inactive"])
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.Id">@L["Edit"]</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="empty-state">@L["NoSuppliersCreatedYet"]</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("suppliersTableSearch");
            const table = document.getElementById("suppliersTable");
            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function () {
                const value = this.value.trim().toLowerCase();
                table.querySelectorAll("tbody tr").forEach((row) => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(value) ? "" : "none";
                });
            });
        });
    </script>
}
