@model RestaurantManagement.Application.DTOs.Reports.ReportOverviewDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Reports"];
}

<section class="dashboard-grid">
    <article class="metric-card">
        <p class="metric-label">@L["GrossSales"]</p>
        <h3 id="repGross">@Model.GrossSales.ToString("N2")</h3>
    </article>
    <article class="metric-card">
        <p class="metric-label">@L["OrdersCount"]</p>
        <h3 id="repOrders">@Model.OrdersCount</h3>
    </article>
    <article class="metric-card">
        <p class="metric-label">@L["AverageTicket"]</p>
        <h3 id="repAvg">@Model.AverageTicket.ToString("N2")</h3>
    </article>
    <article class="metric-card warning">
        <p class="metric-label">@L["LowStockAlerts"]</p>
        <h3 id="repLow">@Model.LowStockCount</h3>
    </article>
</section>

<section class="widget-grid mt-3" id="reportsApp" data-no-data="@L["NoDataYet"]" data-load-error="@L["DataIntegrationPending"]">
    <article class="widget-card">
        <div class="widget-head">
            <h5>@L["SalesTrend"]</h5>
            <div class="btn-group btn-group-sm" role="group">
                <button class="btn btn-outline-secondary rep-range" data-days="7">7D</button>
                <button class="btn btn-outline-secondary rep-range active" data-days="30">30D</button>
                <button class="btn btn-outline-secondary rep-range" data-days="90">90D</button>
            </div>
        </div>
        <div id="reportTrend" class="trend-bars"></div>
    </article>

    <article class="widget-card">
        <div class="widget-head">
            <h5>@L["TopCategorySales"]</h5>
            <span>@L["Today"]</span>
        </div>
        <table class="table shell-table mb-0">
            <thead>
                <tr><th>@L["Category"]</th><th class="text-end">@L["Amount"]</th></tr>
            </thead>
            <tbody id="repCategories">
            @if (Model.TopCategories.Any())
            {
                foreach (var row in Model.TopCategories)
                {
                    <tr><td>@row.CategoryName</td><td class="text-end">@row.SalesAmount.ToString("N2")</td></tr>
                }
            }
            else
            {
                <tr><td colspan="2" class="empty-state">@L["NoDataYet"]</td></tr>
            }
            </tbody>
        </table>
    </article>
</section>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
