@model RestaurantManagement.Application.DTOs.Reports.ReportOverviewDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject RestaurantManagement.Web.Services.ISettingsRuntimeService SettingsRuntime
@{
    ViewData["Title"] = L["Reports"];
    var currencyCode = await SettingsRuntime.GetCurrencyCodeAsync();
    var taxRatePercent = await SettingsRuntime.GetTaxRatePercentAsync();
    var serviceChargePercent = await SettingsRuntime.GetServiceChargePercentAsync();
}

<div class="widget-card crud-shell mb-3">
    <div class="crud-toolbar">
        <div>
            <h5 class="mb-1">@L["ReportsOverview"]</h5>
            <small class="text-muted">@L["CurrentCommercialRuntimeSettings"]</small>
        </div>
        <div class="crud-toolbar-actions">
            <span class="badge text-bg-light">@L["Currency"]: @currencyCode</span>
            <span class="badge text-bg-light">@L["TaxRate"]: @taxRatePercent.ToString("N0")%</span>
            <span class="badge text-bg-light">@L["ServiceCharge"]: @serviceChargePercent.ToString("N0")%</span>
        </div>
    </div>
</div>

<section class="dashboard-grid">
    <article class="metric-card">
        <p class="metric-label">@L["GrossSales"]</p>
        <h3>@Model.GrossSales.ToString("N2")</h3>
    </article>
    <article class="metric-card success">
        <p class="metric-label">@L["OrdersCount"]</p>
        <h3>@Model.OrdersCount</h3>
    </article>
    <article class="metric-card warning">
        <p class="metric-label">@L["AverageTicket"]</p>
        <h3>@Model.AverageTicket.ToString("N2")</h3>
    </article>
    <article class="metric-card">
        <p class="metric-label">@L["LowStockAlerts"]</p>
        <h3>@Model.LowStockCount</h3>
    </article>
</section>

<section class="widget-grid mt-4">
    <article class="widget-card">
        <div class="widget-head">
            <div>
                <h5 class="mb-1">@L["SalesTrend"]</h5>
                <small class="text-muted">@L["Last14Days"]</small>
            </div>
        </div>
        <div id="reportsSalesTrend" class="chart-placeholder" data-reports-trend='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend))'></div>
    </article>

    <article class="widget-card">
        <div class="widget-head">
            <div>
                <h5 class="mb-1">@L["TopCategories"]</h5>
                <small class="text-muted">@L["BySalesValue"]</small>
            </div>
        </div>
        <div id="reportsTopCategories" class="chart-placeholder" data-reports-categories='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopCategories))'></div>
    </article>
</section>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
