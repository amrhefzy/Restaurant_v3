@model RestaurantManagement.Web.ViewModels.Inventory.InventoryOverviewViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject RestaurantManagement.Web.Services.ISettingsRuntimeService SettingsRuntime
@{
    ViewData["Title"] = L["Inventory"];
    ViewData["PageActions"] = $"<a class='btn btn-outline-secondary' href='/PurchaseOrders'>{L["OpenPurchaseOrders"]}</a>";
    var inventoryTrackingEnabled = await SettingsRuntime.IsInventoryTrackingEnabledAsync();
}

<section class="widget-grid">
    <article class="widget-card crud-shell">
        <div class="crud-toolbar">
            <div>
                <h5 class="mb-1">@L["LowStockItems"]</h5>
                <small class="text-muted">@string.Format(L["LowStockAttentionCount"], Model.LowStockItems.Count)</small>
            </div>
            <div class="crud-toolbar-actions">
                <span class="badge text-bg-light">@L["ReorderWatch"]</span>
                <span class="badge @(inventoryTrackingEnabled ? "text-bg-success" : "text-bg-secondary")">
                    @(inventoryTrackingEnabled ? L["InventoryTrackingEnabled"] : L["InventoryTrackingDisabled"])
                </span>
            </div>
        </div>
        <div class="table-responsive mt-3 table-wrapper">
            <table class="table shell-table mb-0">
                <thead>
                    <tr>
                        <th>@L["Product"]</th>
                        <th class="text-end">@L["OnHand"]</th>
                        <th class="text-end">@L["Reorder"]</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.LowStockItems.Any())
                {
                    foreach (var row in Model.LowStockItems)
                    {
                        <tr>
                            <td><div class="table-title">@row.ProductName</div></td>
                            <td class="text-end">@row.OnHandQuantity</td>
                            <td class="text-end">@row.ReorderLevel</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="empty-state">@L["NoLowStockAlerts"]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </article>

    <article class="widget-card crud-shell">
        <div class="crud-toolbar">
            <div>
                <h5 class="mb-1">@L["RecentInventoryMovements"]</h5>
                <small class="text-muted">@string.Format(L["RecentInventoryMovesCount"], Model.RecentMovements.Count)</small>
            </div>
            <div class="crud-toolbar-actions">
                <span class="badge text-bg-light">@L["Last100Moves"]</span>
            </div>
        </div>
        <div class="table-responsive mt-3 table-wrapper">
            <table class="table shell-table mb-0">
                <thead>
                    <tr>
                        <th>@L["WhenUtc"]</th>
                        <th>@L["Product"]</th>
                        <th>@L["Type"]</th>
                        <th class="text-end">@L["Quantity"]</th>
                        <th>@L["Reference"]</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.RecentMovements.Any())
                {
                    foreach (var row in Model.RecentMovements)
                    {
                        <tr>
                            <td>@row.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><div class="table-title">@row.ProductName</div></td>
                            <td><span class="badge text-bg-light">@row.MovementType</span></td>
                            <td class="text-end">@row.QuantityChange</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ReferenceNumber) ? "—" : row.ReferenceNumber)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="empty-state">@L["NoInventoryMovementsYet"]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </article>
</section>
